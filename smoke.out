需人工 SQL 校验的项：
  AC-10-005-1 逻辑删除后物理行仍存在：
  SELECT id, name, deleted FROM t_song WHERE name LIKE '冒烟歌曲%';  -- deleted=1
  冗余计数一致性（以下每条**只列不一致的行**，返回 0 行即通过）：
  SELECT a.name, a.song_count, (SELECT COUNT(*) FROM t_song s WHERE s.artist_id=a.id AND s.deleted=0) c
    FROM t_artist a WHERE a.deleted=0
    AND a.song_count <> (SELECT COUNT(*) FROM t_song s WHERE s.artist_id=a.id AND s.deleted=0);
  SELECT t.name, t.use_count, (SELECT COUNT(*) FROM t_song_tag st WHERE st.tag_id=t.id) c
    FROM t_tag t WHERE t.deleted=0
    AND t.use_count <> (SELECT COUNT(*) FROM t_song_tag st WHERE st.tag_id=t.id);
  SELECT p.name, p.song_count, (SELECT COUNT(*) FROM t_playlist_song ps WHERE ps.playlist_id=p.id) c
    FROM t_playlist p WHERE p.deleted=0
    AND p.song_count <> (SELECT COUNT(*) FROM t_playlist_song ps WHERE ps.playlist_id=p.id);
